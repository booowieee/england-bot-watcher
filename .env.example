# SWS Monitor Bot - Configuration

# Telegram Bot API Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Primary Telegram Chat / Admin ID (get from @userinfobot)
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_ID=123456789

# Check interval in seconds (default: 45)
CHECK_INTERVAL_SECONDS=45

# Heartbeat report interval in hours (0 = disabled)
HEARTBEAT_INTERVAL_HOURS=12

# Enable Playwright screenshots
ENABLE_SCREENSHOTS=true

# Wayback Machine (web.archive.org) snapshot interval in hours (default: 12, twice a day)
ENABLE_WAYBACK_ARCHIVE=true
WAYBACK_INTERVAL_HOURS=12

# Debug mode (true / false)
DEBUG_MODE=false
