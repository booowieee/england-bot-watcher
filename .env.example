# ==============================================================================
# SWS MONITOR BOT - CONFIGURATION
# ==============================================================================

# Telegram Bot API Token (получить в @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Chat ID (получить в @userinfobot или ID вашей группы/канала)
TELEGRAM_CHAT_ID=123456789

# Интервал проверки в секундах (по умолчанию: 45 секунд)
CHECK_INTERVAL_SECONDS=45

# Интервал отправки отчета о работоспособности (Heartbeat) в часах (0 = отключено)
HEARTBEAT_INTERVAL_HOURS=12

# Включить сохранение скриншотов Playwright
ENABLE_SCREENSHOTS=true

# Режим отладки (true / false)
DEBUG_MODE=false
